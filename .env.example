# Add these in Vercel Dashboard → Settings → Environment Variables
# Do NOT upload a real .env file — set them in the Vercel dashboard only

# MongoDB Atlas connection string
# Get this from: MongoDB Atlas → Your Cluster → Connect → Drivers
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority

# Gmail address that sends the notification email
EMAIL_USER=youraddress@gmail.com

# Gmail App Password (16 chars, no spaces) — NOT your normal Gmail password
# Get it at: https://myaccount.google.com/apppasswords
EMAIL_PASS=your16charapppassword

# Where you want contact form emails delivered
EMAIL_TO=khijaarashid@gmail.com

# Secret key to view saved messages at /api/messages?key=...
ADMIN_KEY=choose-a-long-random-secret-here

# Your Vercel domain (set AFTER first deploy, e.g. https://khadija-portfolio.vercel.app)
ALLOWED_ORIGIN=*
